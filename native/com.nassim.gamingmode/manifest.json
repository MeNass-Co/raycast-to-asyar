{
  "id": "com.nassim.gamingmode",
  "name": "Gaming Mode",
  "version": "1.0.0",
  "description": "One toggle that sweeps the Mac for gaming: quits every app and user LaunchAgent outside a keep-list, snapshotting them first. Run it again to restore everything, like a fresh login.",
  "author": "Nassim Lecornet",
  "icon": "data:image/png;base64,",
  "type": "extension",
  "asyarSdk": "^4.10.0",
  "platforms": [
    "macos"
  ],
  "searchable": false,
  "background": {
    "main": "worker.js"
  },
  "permissions": [
    "shell:spawn",
    "notifications:send"
  ],
  "permissionArgs": {
    "shell:spawn": [
      "/bin/zsh"
    ]
  },
  "commands": [
    {
      "id": "toggle-gaming-mode",
      "name": "Gaming Mode",
      "description": "Toggle Gaming Mode: sweep apps and agents for gaming, or restore them.",
      "trigger": "Gaming Mode gaming game gamer play sweep free memory ram restore",
      "icon": "data:image/png;base64,",
      "mode": "background"
    }
  ]
}